# ============================================================
# Gold Tracker Bot — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Admin Telegram chat IDs, comma-separated (e.g. 123456789,987654321)
ADMIN_IDS=123456789

# SQLite database file path
DB_FILE=gold.db

# VNAppMob API endpoint for requesting a gold API key
REQUEST_KEY_URL=https://api.vnappmob.com/api/request_api_key?scope=gold
